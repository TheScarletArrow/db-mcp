# Copy to .env (docker compose reads it automatically) and edit.

# The vault key is derived from this passphrase. Use the same value everywhere
# you start db-mcp: one passphrase, one vault.
DB_MCP_MASTER_PASSWORD=

# Server-wide switch for execute_statement (INSERT/UPDATE/DELETE/DDL).
DB_MCP_ALLOW_WRITES=false

# Host port for the MCP endpoint (container side is always 8080).
DB_MCP_PORT=8080

# Run the published image instead of building locally:
#DB_MCP_IMAGE=ghcr.io/thescarletarrow/db-mcp:latest
#DB_MCP_PULL_POLICY=always
